{
  "name": "signalsponsor-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push --skip-generate",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma --skip-generate",
    "db:reset:postgres": "prisma db push --schema prisma/schema.postgres.prisma --force-reset --skip-generate && node --env-file=.env --import tsx prisma/seed.ts",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && node --env-file=.env --import tsx prisma/seed.ts",
    "jobs:run": "node --env-file=.env --import tsx scripts/job-worker.ts --once",
    "jobs:work": "node --env-file=.env --import tsx scripts/job-worker.ts",
    "postinstall": "prisma generate && node scripts/link-prisma-client.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.6.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "next": "^15.0.0",
    "openai": "^5.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
